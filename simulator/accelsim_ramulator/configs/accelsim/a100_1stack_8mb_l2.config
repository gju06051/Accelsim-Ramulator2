# AccelSim/GPGPU-Sim override fragment for quick A100-style 1-stack sweeps.
#
# Pass this with:
#   --accelsim-config-override-file configs/accelsim/a100_1stack_8mb_l2.config
#
# The runner also appends -gpgpu_max_cycle and runtime-stat overrides after this
# fragment.

-gpgpu_n_clusters 22
-gpgpu_n_mem 8
-gpgpu_memory_partition_indexing 2
# 32 subpartitions * (128 sets * 128 B line * 16-way) = 8 MiB.
-gpgpu_cache:dl2 S:128:128:16,L:B:m:L:X,A:192:4,32:0,32
