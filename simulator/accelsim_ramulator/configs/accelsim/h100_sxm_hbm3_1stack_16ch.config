# AccelSim/GPGPU-Sim override fragment for an H100 SXM-style 1-stack HBM3 run.
#
# Keep the base SM80 compute-capability/PTX path for benchmark compatibility.
# This fragment only changes performance-geometry knobs.
#
# H100 SXM 1/5-stack target:
#   26 SMs, the nearest integer to 132 / 5
#   128 FP32 lanes/SM behavior via FP32 initiation interval 1
#   1024-bit HBM3 modeled as 16 x 64-bit channels
#   10 MiB L2 modeled as 32 subpartitions * 320 KiB/subpartition

-gpgpu_n_clusters 26

# Keep H100-style clocks and FP32 issue behavior from the 80-channel full config.
-gpgpu_clock_domains 1980:1980:1980:1309
-ptx_opcode_initiation_fp 1,1,1,1,2

# H100-style unified L1/shared memory pool while preserving SM80 compatibility.
-gpgpu_shmem_option 0,8,16,32,64,100,132,164,196,228
-gpgpu_unified_l1d_size 256
-gpgpu_shmem_size 233472
-gpgpu_shmem_sizeDefault 233472

# One HBM3 stack: 16 physical 64-bit channels. Two L2 subpartitions per channel
# gives 32 subpartitions total.
-gpgpu_n_mem 16
-gpgpu_n_sub_partition_per_mchannel 2

# 32 subpartitions * (128 sets * 128 B line * 20-way) = 10 MiB.
-gpgpu_cache:dl2 S:128:128:20,L:B:m:L:X,A:192:4,32:0,32

# 16 channels is power-of-two, so the balanced IPoly path does not need folding.
-gpgpu_memory_partition_indexing 2
-gpgpu_mem_address_mask 1
-gpgpu_mem_addr_mapping dramid@8;00000000.00000000.00000000.00000000.0000RRRR.RRRRRRRR.RBBBCCCC.BCCSSSSS
