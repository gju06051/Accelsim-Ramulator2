# AccelSim/GPGPU-Sim override fragment for an H100 SXM-style HBM3 run.
#
# Keep the base SM80 compute-capability/PTX path for benchmark compatibility.
# This fragment only changes performance-geometry knobs: SM count, FP32 issue
# rate, clocks, L1/shared memory, L2 size, and HBM3 memory partition topology.
#
# H100 SXM target:
#   132 SMs
#   128 FP32 lanes/SM behavior via FP32 initiation interval 1
#   5120-bit HBM3 modeled as 80 x 64-bit physical channels
#     each physical channel is 2 x 32-bit pseudochannels
#   50 MiB L2 modeled as 160 subpartitions * 320 KiB/subpartition

-gpgpu_n_clusters 132

# Approximate H100 SXM FP32 peak from 132 SM * 128 FP32/SM * 2 FLOP/FMA at
# about 1.98 GHz while preserving the SM80 functional path. Use the Samsung
# HBM3 paper-device CK for the DRAM domain.
-gpgpu_clock_domains 1980:1980:1980:2000
-ptx_opcode_initiation_fp 1,1,1,1,2

# H100 has a larger unified L1/shared pool than A100. Keep the default
# per-block limit at the base-config value for benchmark compatibility.
-gpgpu_shmem_option 0,8,16,32,64,100,132,164,196,228
-gpgpu_unified_l1d_size 256
-gpgpu_shmem_size 233472
-gpgpu_shmem_sizeDefault 233472

# 80 physical 64-bit HBM3 channels. Two L2 subpartitions per channel keeps the
# total L2 subpartition count at 160, matching the A100 base geometry while
# changing channel granularity.
-gpgpu_n_mem 80
-gpgpu_n_sub_partition_per_mchannel 2

# Keep the official AccelSim SM80_A100 DRAM queue sizing as the default
# scheduler/backend queue baseline.
-gpgpu_dram_partition_queues 64:64:64:64
-gpgpu_frfcfs_dram_sched_queue_size 64
-gpgpu_dram_return_queue_size 192

# 160 subpartitions * (128 sets * 128 B line * 20-way) = 50 MiB.
-gpgpu_cache:dl2 S:128:128:20,L:B:m:L:X,A:192:4,32:0,32

# Use the balanced partition hashing path. For 80 channels this hashes in a
# virtual 128-channel domain and folds back to 80 in addrdec.cc.
#
# Ramulator2 models H100's lower HBM3 stack geometry per physical channel as:
#   column CA[4:0] + pseudochannel(1b) + SID(1b) + bankgroup(2b)
#   + bank(2b) + row RA[13:0]. S[4:0] is the 32B column access atom offset.
# AccelSim keeps the channel digit at bit 8; Ramulator2 removes the same digit
# through AddrMapper.channel_start_bit before applying the lower-level map.
# The lowest bank bit selects the 2 L2 subpartitions under each channel.
-gpgpu_memory_partition_indexing 2
-gpgpu_mem_address_mask 1
-gpgpu_mem_addr_mapping dramid@8;00000000.00000000.00000000.00000000.00RRRRRR.RRRRRRRR.BBBBBBCC.CCCSSSSS

# Keep AccelSim's local bank decoder consistent with the flattened
# pseudochannel/SID/bankgroup/bank field. Ramulator2 supplies the real DRAM
# timing path for ramulator2 backend runs.
-gpgpu_dram_timing_opt nbk=64:CCD=2:RRD=5:RCD=30:RAS=66:RP=30:RC=96:CL=29:WL=13:CDLR=9:WR=13:nbkgrp=4:CCDL=4:RTPL=5
