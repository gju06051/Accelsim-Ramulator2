# AccelSim/GPGPU-Sim override fragment for an RTX 5090-style GDDR7 run.
#
# Keep the base SM80 compute-capability/PTX path for benchmark compatibility.
# This fragment changes only performance-geometry knobs: SM count, FP32 issue
# rate, clocks, L1/shared memory, L2 size, and GDDR7 memory partition topology.
#
# RTX 5090 target:
#   170 SMs
#   128 FP32 lanes/SM behavior via FP32 initiation interval 1
#   512-bit GDDR7 modeled as 64 x 8-bit byte-wide channels
#   32 GiB GDDR7 at 28Gbps/pin, 1.792 TB/s peak pin bandwidth
#   96 MiB L2 modeled as 128 subpartitions * 768 KiB/subpartition

-gpgpu_n_clusters 170

# Use the public RTX 5090 base core clock and the 28Gbps GDDR7 CK4 clock.
# GDDR7 PAM3 effective rate is 16x CK4, so 28Gbps maps to 1750MHz.
-gpgpu_clock_domains 2017:2017:2017:1750
-ptx_opcode_initiation_fp 1,1,1,1,2

# Approximate the published 128 KiB L1 cache per SM while preserving the SM80
# functional path used by the local AccelSim frontend.
-gpgpu_shmem_option 0,8,16,32,64,100,128
-gpgpu_unified_l1d_size 128
-gpgpu_shmem_size 131072
-gpgpu_shmem_sizeDefault 131072

# 512-bit GDDR7 as 64 externally visible byte-wide channels. Two L2
# subpartitions per channel gives 128 subpartitions total.
-gpgpu_n_mem 64
-gpgpu_n_sub_partition_per_mchannel 2

# 128 subpartitions * (128 sets * 128 B line * 48-way) = 96 MiB.
-gpgpu_cache:dl2 S:128:128:48,L:B:m:L:X,A:192:4,32:0,32

# Use the balanced partition hashing path. For 64 channels this is a power-of-2
# domain, so no channel folding is needed.
#
# Ramulator2's GDDR7 model is channel -> bank -> row -> column. A 16Gb x32
# package exposes four byte-wide channels; the full RTX 5090 memory system is
# represented as sixteen packages, or 64 channels total. The lower address
# layout keeps the channel digit at bit 8 for AccelSim and removes it in the
# Ramulator2 ExternalChannelRoBaRaCoCh mapper before applying:
#   row RA[13:0] + bank BA[3:0] + column CA[5:0] + S[4:0].
-gpgpu_memory_partition_indexing 2
-gpgpu_mem_address_mask 1
-gpgpu_mem_addr_mapping dramid@8;00000000.00000000.00000000.00000000.000RRRRR.RRRRRRRR.RBBBBCCC.CCCSSSSS

# Keep AccelSim's local bank decoder consistent with the 16-bank GDDR7 model.
# Ramulator2 supplies the real DRAM timing path for ramulator2 backend runs.
-gpgpu_dram_timing_opt nbk=16:CCD=2:RRD=22:RCD=32:RAS=53:RP=36:RC=88:CL=10:WL=9:CDLR=4:WR=53:nbkgrp=4:CCDL=4:RTPL=4
